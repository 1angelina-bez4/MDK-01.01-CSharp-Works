<Window x:Class="pr_25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pr-25" 
        Height="373"
        Width="574">
    <Grid>
        <TabControl>
            <TabItem Header="Задание 1">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Проверить истинность высказывания: Данное целое положительное число является четным трехзначным числом." VerticalAlignment="Top" Grid.ColumnSpan="2" Height="59" Width="558"/>
                    <Label Content="Введите число:" HorizontalAlignment="Left" Margin="234,82,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.484,0.666" Grid.Column="1" Height="26" Width="104">
                        <Label.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.25"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Label.RenderTransform>
                    </Label>
                    <TextBox Name="input_textBox" HorizontalAlignment="Center" Margin="0,113,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="149" Grid.Column="1" Height="34"/>
                    <Button Content="Решить" HorizontalAlignment="Center" Margin="0,165,0,0" VerticalAlignment="Top" Height="42" Width="128" Grid.Column="1"  Click="Task1Button_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Задание 2">
                <Grid Background="#FFE5E5E5">
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Даны целые положительные числа A и B (A меньше  B). Вывести все целые числа от A до B включительно; при этом каждое число должно выводиться столько раз, каково его значение (например, число 3 выводится 3 раза)." VerticalAlignment="Top" Height="62" Width="548"/>
                    <Label Content="Введите число А :" HorizontalAlignment="Left" Margin="82,107,0,0" VerticalAlignment="Top"/>
                    <Label Content="Введите число В :" HorizontalAlignment="Left" Margin="384,107,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.482,0.589"/>
                    <TextBox Name="input2_textBox" HorizontalAlignment="Left" Margin="71,138,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="129" Height="27"/>
                    <TextBox Name="input3_textBox" HorizontalAlignment="Left" Margin="373,138,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="129" Height="27"/>
                    <Button Content="Решить" HorizontalAlignment="Center" Margin="0,194,0,0" VerticalAlignment="Top" Height="36" Width="126" Click="Task2Button_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Задание 3">
                <Grid Background="#FFE5E5E5">
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Дан целочисленный массив, состоящий из N элементов (N > 0). Сложить со всеми четными числами максимальное нечетное число из этого массива. Вывести новый полученный массив." VerticalAlignment="Top" RenderTransformOrigin="0.527,0.531" Height="65" Width="548"/>
                    <Label Content="Введите число элементов массива:" HorizontalAlignment="Center" Margin="0,75,0,0" VerticalAlignment="Top" Height="27" Width="210"/>
                    <TextBox Name="input4_textBox" HorizontalAlignment="Center" Margin="0,118,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="188" Height="37"/>
                    <Button Content="Решить" HorizontalAlignment="Center" Margin="0,202,0,0" VerticalAlignment="Top" Height="48" Width="146" Click="Task3Button_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Задание 4">
                <Grid Background="#FFE5E5E5">
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Написать функцию int Min3(A, B, C) целого типа, возвращающую одно минимальное значение из 3-х своих аргументов (параметры A, B, C - целые числа)." VerticalAlignment="Top" Height="79" Width="548"/>
                    <Label Content="Введите число А :" HorizontalAlignment="Left" Margin="10,71,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.496,0.596"/>
                    <Label Content="Введите число B :" HorizontalAlignment="Left" Margin="230,71,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.496,0.596"/>
                    <Label Content="Введите число C :" HorizontalAlignment="Left" Margin="438,71,0,0" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.496,0.596"/>
                    <TextBox Name="input5_textBox" HorizontalAlignment="Left" Margin="10,102,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="29"/>
                    <TextBox Name="input6_textBox" HorizontalAlignment="Center" Margin="0,102,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="132" Height="29"/>
                    <TextBox Name="input7_textBox" HorizontalAlignment="Left" Margin="438,102,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="114" Height="29"/>
                    <Button Content="Решить" HorizontalAlignment="Center" Margin="0,194,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.535,0.515" Height="41" Width="132" Click="Task4Button_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Задание 5" Margin="-2,-2,-2,0">
                <Grid Background="#FFE5E5E5">
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Вводится строка, состоящая из слов, разделенных подчеркиваниями (одним или несколькими). Длина строки может быть разной. Определить и вывести на экран слово/слова, которые содержат ровно три буквы 'x'." VerticalAlignment="Top" Height="56" Width="548"/>
                    <Label Content="Введите строку :" HorizontalAlignment="Center" Margin="0,94,0,0" VerticalAlignment="Top" Width="105" RenderTransformOrigin="0.496,0.596"/>
                    <TextBox Name="input8_textBox1" HorizontalAlignment="Center" Margin="0,135,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="40"/>
                    <Button Content="Решить" HorizontalAlignment="Center" Margin="0,194,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.535,0.515" Height="41" Width="132" Click="Task5Button_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
